## 4) Реализация в `Audio.cpp`

### 4.1. В `connecttoFS(...)`: запомнить FS и путь
В начале `Audio::connecttoFS(fs::FS& fs, const char* path, ...)` у вас уже есть `fs` и `path`.   
Добавьте:

```cpp
m_localFS = &fs;
m_localPath.copy_from(path);
m_localPath.trim();
```

(делайте это **до** `setDefaults()`, иначе `ps_ptr` может очиститься — зависит от вашей реализации `setDefaults()`).

### 4.2. `omnia_m4aIndexReset()`
Вызывайте из `setDefaults()` (чтобы при смене трека всё чистилось), и из `stopSong()` при желании.

```cpp
void Audio::omnia_m4aIndexReset() {
  m_m4aIdxValid = false;
  m_m4aSeekExactNext = false;

  if(m_m4aIdxFile) m_m4aIdxFile.close();

  m_m4aDurSec = 0;
  m_m4aDurMs  = 0;
  m_m4aFramesTotal = 0;

  m_m4aBuildNextFrame = 0;
  m_m4aBuildNextSec   = 1;
  m_m4aBuildCumBytes  = 0;

  m_m4aSecFrame.reset();
  m_m4aSecOff.reset();
}
```

### 4.3. Инициализация индекса: `omnia_m4aIndexInitIfPossible()`
Вызывайте **после** того как M4A распарсен и установлены:
- `m_audioDataStart/m_audioDataSize`
- `m_audioFileDuration`
- `m_stsz_position`
- `m_stsz_numEntries` 

```cpp
void Audio::omnia_m4aIndexInitIfPossible() {
  if(m_codec != CODEC_M4A) return;
  if(!m_localFS || !m_localPath.valid()) return;
  if(!m_audioFileDuration) return;
  if(!m_stsz_position || !m_stsz_numEntries) return;

  omnia_m4aIndexReset();

  m_m4aDurSec = m_audioFileDuration;
  m_m4aDurMs  = m_audioFileDuration * 1000UL;
  m_m4aFramesTotal = m_stsz_numEntries;

  // alloc arrays: (durSec+1)
  uint32_t n = m_m4aDurSec + 1;
  m_m4aSecFrame.calloc(n * sizeof(uint32_t));
  m_m4aSecOff.calloc(n * sizeof(uint32_t));
  if(!m_m4aSecFrame.get() || !m_m4aSecOff.get()) return;

  m_m4aIdxFile = m_localFS->open(m_localPath.get(), "r");
  if(!m_m4aIdxFile) return;

  m_m4aIdxFile.seek(m_stsz_position);

  m_m4aBuildNextFrame = 0;
  m_m4aBuildNextSec   = 1;
  m_m4aBuildCumBytes  = 0;

  m_m4aSecFrame[0] = 0;
  m_m4aSecOff[0]   = 0;

  m_m4aIdxValid = true;
}
```

### 4.4. Построение индекса “по чуть‑чуть”: `omnia_m4aIndexTick()`
Ключ: не блокировать аудио. Вызывайте tick только когда буфер достаточно наполнен.

```cpp
static inline uint32_t be32(const uint8_t* b){
  return ((uint32_t)b[0] << 24) | ((uint32_t)b[1] << 16) | ((uint32_t)b[2] << 8) | (uint32_t)b[3];
}

void Audio::omnia_m4aIndexTick(uint16_t maxEntries){
  if(!m_m4aIdxValid) return;
  if(m_m4aBuildNextFrame >= m_m4aFramesTotal) return;
  if(!m_m4aIdxFile) { m_m4aIdxValid=false; return; }

  // throttle: если буфера мало — не лезем на SD второй раз
  if(InBuff.bufferFilled() < InBuff.getMaxBlockSize() * 3) return;

  // убедиться что мы читаем с правильной позиции
  uint64_t needPos = (uint64_t)m_stsz_position + (uint64_t)m_m4aBuildNextFrame * 4ULL;
  if((uint64_t)m_m4aIdxFile.position() != needPos) m_m4aIdxFile.seek(needPos);

  for(uint16_t i=0; i<maxEntries && m_m4aBuildNextFrame < m_m4aFramesTotal; i++){
    uint8_t b[4];
    if(m_m4aIdxFile.read(b, 4) != 4) { m_m4aIdxValid=false; break; }

    uint32_t sz = be32(b);
    m_m4aBuildCumBytes += sz;
    m_m4aBuildNextFrame++;

    // закрываем “секунды” по мере прохождения
    while(m_m4aBuildNextSec <= m_m4aDurSec){
      // frame boundary для секунды: пропорцией по общему числу фреймов
      uint32_t boundary = (uint64_t)m_m4aBuildNextSec * m_m4aFramesTotal / m_m4aDurSec;
      if(m_m4aBuildNextFrame < boundary) break;

      m_m4aSecFrame[m_m4aBuildNextSec] = m_m4aBuildNextFrame;
      m_m4aSecOff[m_m4aBuildNextSec]   = (uint32_t)m_m4aBuildCumBytes;
      m_m4aBuildNextSec++;
    }
  }

  // финализация
  if(m_m4aBuildNextFrame >= m_m4aFramesTotal){
    m_m4aSecFrame[m_m4aDurSec] = m_m4aFramesTotal;
    m_m4aSecOff[m_m4aDurSec]   = (uint32_t)m_m4aBuildCumBytes; // ~= audioDataSize
  }
}
```

### 4.5. Seek по времени: `omnia_m4aSeekMs(ms)`
Это даёт **точную границу AAC access unit** и позволяет **пропустить** `m4a_correctResumeFilePos()`.

```cpp
bool Audio::omnia_m4aSeekMs(uint32_t ms){
  if(m_codec != CODEC_M4A) return false;
  if(!m_m4aIdxValid) return false;
  if(!m_m4aDurMs || m_m4aFramesTotal == 0) return false;

  if(ms > m_m4aDurMs) ms = m_m4aDurMs;

  uint32_t sec = ms / 1000UL;
  if(sec > m_m4aDurSec) sec = m_m4aDurSec;

  // маленький “burst”, чтобы индекс догнал нужную секунду, но без лагов
  uint32_t t0 = millis();
  while(m_m4aBuildNextSec <= sec && (millis() - t0) < 8){
    omnia_m4aIndexTick(512);
    yield();
  }

  uint32_t baseFrame = 0;
  uint32_t baseOff   = 0;
  if(sec <= m_m4aDurSec && m_m4aSecFrame.get()){
    baseFrame = m_m4aSecFrame[sec];
    baseOff   = m_m4aSecOff[sec];
  }

  uint32_t targetFrame = (uint64_t)ms * m_m4aFramesTotal / m_m4aDurMs;
  if(targetFrame < baseFrame) { baseFrame = 0; baseOff = 0; }

  uint32_t need = targetFrame - baseFrame;

  uint64_t off = baseOff;

  // досуммировать sizes внутри секунды (обычно десятки фреймов)
  if(need){
    uint32_t saved = m_m4aIdxFile.position();
    uint64_t pos = (uint64_t)m_stsz_position + (uint64_t)baseFrame * 4ULL;
    m_m4aIdxFile.seek(pos);

    for(uint32_t i=0; i<need; i++){
      uint8_t b[4];
      if(m_m4aIdxFile.read(b, 4) != 4) break;
      off += be32(b);
    }

    m_m4aIdxFile.seek(saved);
  }

  uint32_t absPos = m_audioDataStart + (uint32_t)off;

  m_m4aSeekExactNext = true;
  return setFilePos(absPos);
}
```

### 4.6. В `newInBuffStart()` пропустить `m4a_correctResumeFilePos()` если seek был “точным”
Сейчас у вас M4A всегда делает коррекцию. 

Замените кусок:

```cpp
if(m_codec == CODEC_M4A){
  m_resumeFilePos += m4a_correctResumeFilePos();
  if(m_resumeFilePos == -1) goto exit;
}
```

на:

```cpp
if(m_codec == CODEC_M4A){
  if(!m_m4aSeekExactNext){
    m_resumeFilePos += m4a_correctResumeFilePos();
    if(m_resumeFilePos == -1) goto exit;
  }
  m_m4aSeekExactNext = false;
}
```

Это **ключевой** момент: именно он убирает “seek лаги” и “seek → next” на M4A.

