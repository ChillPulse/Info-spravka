                             (unsigned)InBuff.bufferFilled(),
                             (unsigned)m_mf_header_ready,
                             (unsigned)left);
              }
          }
          // no more progress possible in this call
          break;
      }

      if(mf_res == END_OF_STREAM){ m_f_eof=true; break; }

      // errors
      AUDIO_ERROR("microflac decode error %d consumed=%u header=%u",
                  (int)mf_res, (unsigned)bytes_consumed, (unsigned)m_mf_header_ready);
      if(!m_mf_header_ready){
          // fatal before header
          microflac_reset_();
          m_mf_active = true;
          m_sbyt.bytesLeft = len - total_consumed;
          // force bytesDecoded via bytesLeft:
          // fallthrough after loop
          res = -100;
          break;
      } else {
          // after header: skip 1 byte to resync rather than reconnect immediately
          if(left > 0){ p += 1; left -= 1; total_consumed += 1; }
          // soft reset frame path is inside microflac on errors after header
          continue;
      }
  }

  // set leftovers for common epilogue
  m_sbyt.bytesLeft = len - total_consumed;  // IMPORTANT: common code does bytesDecoded = len - bytesLeft
