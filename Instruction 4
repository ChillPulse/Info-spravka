2) ROOT-FIX #1 — decode_ogg: запретить 0-consume spin (ОБЯЗАТЕЛЬНО)
========================================================
Файл: yoRadio/src/audioI2S/micro_flac/flac_decoder.cpp
Функция: FLACDecoder::decode_ogg

2.1) СЕЙЧАС (баг):
  while(true){
    if((mf_millis()-t0) > 12) return NEED_MORE_DATA; // ← может вернуть consumed=0
    state = ogg_demuxer_->get_next_data(...)
    if(state.result == OGG_NEED_MORE_DATA){
      if(bytes_consumed < input_len) continue; // ← SPIN при consumed+=0
      return NEED_MORE_DATA;
    }
    ...
  }

Это ровно Log58: после HEADER_READY demuxer/path крутится без progress →
budget → NEED_MORE consumed=0 → outer zero_cons++ → stall.

2.2) ЗАМЕНИТЬ budget+spin логику на upstream-совместимую + safe yield:

  const uint32_t t0 = mf_millis();
  uint32_t idle_iters = 0;
  while (true) {
      size_t remaining = input_len - bytes_consumed;
      auto state = this->ogg_demuxer_->get_next_data(input + bytes_consumed, remaining);

      // A) прогресс по входу
      if (state.bytes_consumed > 0) {
          bytes_consumed += state.bytes_consumed;
          idle_iters = 0;
      } else {
          idle_iters++;
      }

      // B) OGG_NEED_MORE_DATA
      if (state.result == micro_ogg::OGG_NEED_MORE_DATA) {
          if (this->ogg_eos_seen_) return FLAC_DECODER_END_OF_STREAM;

          // Если input ещё есть, но demuxer не ест — ЭТО НЕ "need more".
          // Нельзя spin'ить до budget с return consumed=0.
          if (state.bytes_consumed == 0 && remaining > 0) {
              // Soft-resync once: найти следующий OggS в remaining
              const uint8_t* p = input + bytes_consumed;
              size_t r = remaining;
              size_t k = 1; // skip at least 1 byte to avoid infinite same pos
              for (; k + 3 < r; k++) {
                  if (p[k]=='O' && p[k+1]=='g' && p[k+2]=='g' && p[k+3]=='S') break;
              }
              if (k + 3 < r) {
                  this->ogg_demuxer_->reset();
                  bytes_consumed += k;
                  idle_iters = 0;
                  continue;
              }
              // OggS не нашли в этом chunk — съесть 0 нельзя: вернуть NEED_MORE
              // ТОЛЬКО если уже был progress в этом вызове; иначе съесть 1 байт
              // чтобы outer layer сдвинул окно (anti-stuck).
              if (bytes_consumed == 0) {
                  bytes_consumed = 1; // CRITICAL anti-zero-consume
              }
              return FLAC_DECODER_NEED_MORE_DATA;
          }

          // Нормальный need-more: либо progress был, либо input кончился
          return FLAC_DECODER_NEED_MORE_DATA;
      }

      // C) пустой OK / SKIPPED без consume — не spin
      if (state.bytes_consumed == 0 &&
          (state.result == micro_ogg::OGG_OK && state.packet.length == 0)) {
          if (bytes_consumed == 0 && remaining > 0) bytes_consumed = 1;
          return FLAC_DECODER_NEED_MORE_DATA;
      }
      if (state.bytes_consumed == 0 && state.result == micro_ogg::OGG_PACKET_SKIPPED) {
          if (bytes_consumed == 0 && remaining > 0) bytes_consumed = 1;
          return FLAC_DECODER_NEED_MORE_DATA;
      }

      // D) time budget — ТОЛЬКО если уже есть progress ИЛИ input исчерпан
      if ((mf_millis() - t0) > 40) {
          if (bytes_consumed > 0 || remaining == 0) {
              return FLAC_DECODER_NEED_MORE_DATA;
          }
          // no progress + input remains: дать ещё немного, потом anti-stuck
          if ((mf_millis() - t0) > 80) {
              if (bytes_consumed == 0 && remaining > 0) bytes_consumed = 1;
              return FLAC_DECODER_NEED_MORE_DATA;
          }
      }

      // E) errors: radio-tolerant resync (сохранить идею Rec53h), но
      //    обязательно увеличивать bytes_consumed при skip-to-OggS
      if (state.result < 0) {
          this->ogg_demuxer_->reset();
          if (bytes_consumed < input_len) {
              const uint8_t* p = input + bytes_consumed;
              size_t r = input_len - bytes_consumed;
              size_t k = 0;
              for (; k + 3 < r; k++) {
                  if (p[k]=='O' && p[k+1]=='g' && p[k+2]=='g' && p[k+3]=='S') break;
              }
              if (k + 3 < r) {
                  bytes_consumed += (k == 0 ? 1 : k); // always move
                  continue;
              }
          }
          if (bytes_consumed == 0 && input_len > 0) bytes_consumed = 1;
          return FLAC_DECODER_NEED_MORE_DATA;
      }

      if (state.result == micro_ogg::OGG_PACKET_SKIPPED) {
          continue; // bytes already accounted if any
      }
      if (state.result != micro_ogg::OGG_OK) {
          return this->set_fatal_error(FLAC_DECODER_ERROR_OGG_DEMUX);
      }

      // F) packet body → decode_native (как сейчас)
      //    ВАЖНО: пустой body — continue/need more БЕЗ zero-return если input остался
      ... existing BOS strip + decode_native ...

      // native_consumed == body_len check — оставить
      // HEADER_READY / SUCCESS / NEED_MORE(continue) / errors — оставить
  }

