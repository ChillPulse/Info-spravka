3.3) ПЕРЕПИСАТЬ ядро sendBytes micro-flac:

ПРАВИЛА:
  - после ЛЮБОГО stallReconnect(...) немедленно return 0;
  - feed: len = min(len, InBuff.getMaxBlockSize(), 65535); убрать «вечный» узкий feedCap как главную логику
  - локальный while(loops < MF_WEB_MAX_LOOPS && left > 0)
  - out/out_cap пересчитывать КАЖДУЮ итерацию:
      out = (m_mf_header_ready && m_mf_out32 && m_mf_out32_cap) ? m_mf_out32 : nullptr;
      out_cap = out ? m_mf_out32_cap : 0;
  - g_mf.decode(p, left, out, out_cap, bytes_consumed, samples_decoded)

HEADER_READY:
  - validate info.is_valid()
  - setChannels/SR/BPS, IIR clear+recalc, showCodecParams (как сейчас flagship post-config)
  - alloc out32 = get_output_buffer_size_samples(); ps_malloc; cap=needed
  - m_mf_header_ready=true; m_mf_headerReadyAtMs=millis(); m_mf_lastProgressMs=millis()
  - log: "microflac HEADER_READY sr=.. ch=.. bps=.. out_cap=.. consumed=.. left=.."
  - если bytes_consumed>0: p+=, left-=, total_consumed+=, zeroCnt=0
  - continue; // СРАЗУ пробовать первый audio frame с out32

SUCCESS:
  - m_mf_pending_total = samples_decoded; m_mf_pending_off=0
  - m_lastGoodDecodeMs = m_mf_lastProgressMs = millis(); zeroCnt=0
  - log: "microflac SUCCESS samples=%u consumed=%u total_cons=%u filled=%u"
  - break; // PCM drain в playAudioData

NEED_MORE_DATA:
  - если bytes_consumed>0: advance, zeroCnt=0, lastProgress=now
  - else zeroCnt++
  - soft log: первые 3 и каждые 20:
      "microflac NEED_MORE zero_cons=%u filled=%u header=%u left=%u out=%u lastRes=%d"
  - break; // нужен новый input window

END_OF_STREAM: m_f_eof=true; break;

ERRORS (<0):
  - log "microflac decode error %d consumed=%u header=%u out_cap=%u"
  - if !header_ready: reset+res=-100; break
  - else: soft skip 1 byte (p+=1; total_consumed+=1) и continue (resync), НЕ reconnect сразу

После loop:
  m_sbyt.bytesLeft = len - total_consumed;
  // common epilogue делает bytesDecoded = len - bytesLeft

  // stall policy (НЕ по одному zero_cons):
  bool grace = m_mf_header_ready && m_mf_headerReadyAtMs &&
               (millis()-m_mf_headerReadyAtMs) < MF_WEB_GRACE_AFTER_HEADER_MS;
  bool timed_stall = m_mf_lastProgressMs &&
                     (millis()-m_mf_lastProgressMs) > MF_WEB_STALL_MS &&
                     InBuff.bufferFilled() > 60000;
  if (!grace && timed_stall && m_mf_zeroConsumeCnt >= MF_WEB_ZERO_CONSUME_LIMIT) {
      AUDIO_ERROR("microflac hard stall -> reconnect");
      stallReconnect("mf_hard_stall");
      return 0; // CRITICAL
  }

  if (m_mf_pending_total > m_mf_pending_off) res = 0;
  else if (fatal) res = -100;
  else res = FLAC_DECODE_FRAMES_LOOP;

