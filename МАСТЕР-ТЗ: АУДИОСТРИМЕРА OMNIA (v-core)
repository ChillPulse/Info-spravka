## ГЛАВА 2: Аппаратная интеграция носителей (SPI3 SD-Карта и USB-Host MSC)
Для изоляции шин и предотвращения взаимных задержек SD-карта подключается по аппаратному интерфейсу SPI3_HOST, освобождая SPI2_HOST под дисплей. USB-накопитель инициализируется через стек Mass Storage Class (MSC) встроенного USB-OTG контроллера.
Агент разворачивает виртуальную файловую систему (VFS) в файле lib/media_indexer/storage_hal.cpp:

#include "esp_vfs_fat.h"#include "driver/sdspi_host.h"#include "driver/spi_common.h"#include "sdmmc_cmd.h"#include "config_pins.h"#include "esp_log.h"
static const char* TAG = "OMNIA_STORAGE";static sdmmc_card_t* s_card = nullptr;
bool init_sd_card_spi3() {
    ESP_LOGI(TAG, "Инициализация SD-карты на выделенной аппаратной шине SPI3...");
    
    spi_bus_config_t bus_cfg = {
        .mosi_io_num = PIN_SD_MOSI,
        .miso_io_num = PIN_SD_MISO,
        .sclk_io_num = PIN_SD_SCK,
        .quadwp_io_num = -1,
        .quadhd_io_num = -1,
        .max_transfer_sz = 16384,
        .flags = SPICOMMON_BUSFLAG_MASTER
    };
    
    if (spi_bus_initialize(SPI3_HOST, &bus_cfg, SPI_DMA_CH_AUTO) != ESP_OK) {
        ESP_LOGE(TAG, "Сбой инициализации шины SPI3!");
        return false;
    }

    sdspi_device_config_t slot_config = SDSPI_DEVICE_CONFIG_DEFAULT();
    slot_config.gpio_cs = (gpio_num_t)PIN_SD_CS;
    slot_config.host_id = SPI3_HOST;

    esp_vfs_fat_sdmmc_mount_config_t mount_config = {
        .format_if_mount_failed = false,
        .max_files = 5,
        .allocation_unit_size = 16 * 1024
    };

    sdmmc_host_t host = SDSPI_HOST_DEFAULT();
    host.slot = SPI3_HOST;
    host.max_freq_khz = 20000; // Стабильные 20 МГц

    esp_err_t err = esp_vfs_fat_sdcard_mount("/sd", &host, &slot_config, &mount_config, &s_card);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Ошибка монтирования VFS пути /sd. Код: %s", esp_err_to_name(err));
        return false;
    }

    ESP_LOGI(TAG, "SD-карта смонтирована по пути /sd");
    return true;
}
