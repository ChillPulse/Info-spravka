## ГЛАВА 4: Модуль Хранителей Экрана Standby и Информационный Метео-Виджет по Wi-Fi
В режиме сна аудио-ядро разгружено. Задача vTaskUIEngine на Core 1 переключает дисплей в режим низкого энергопотребления и выводит утонченную погодную станцию, забирая данные по сети Wi-Fi RSSI от Open-Meteo API [🔗].
Создайте файл lib/ui_engine/standby_manager.cpp:

#include "lvgl.h"#include "ArduinoJson.h"#include "esp_log.h"#include <string.h>
static lv_obj_t* standby_root = NULL;static lv_obj_t* lbl_clock = NULL;static lv_obj_t* lbl_weather = NULL;
void build_vcore_standby_screen(const char* time_str, const char* json_weather_reply) {
    if (standby_root == NULL) {
        // Полная очистка памяти от тяжелых объектов плеера плейлистов
        lv_obj_clean(lv_screen_active());
        
        standby_root = lv_obj_create(NULL);
        lv_obj_set_style_bg_color(standby_root, lv_color_make(0,0,0), 0); // Чистый черный Obsidian фон

        // Часы: Шрифт Inter Thin 48pt (скомпилирован в 4-бит антиалиасинг)
        lbl_clock = lv_label_create(standby_root);
        lv_obj_align(lbl_clock, LV_ALIGN_LEFT_MID, 15, -10);
        lv_obj_set_style_text_color(lbl_clock, lv_color_make(245, 245, 250), 0);

        // Погода: Утонченный Thin виджет справа
        lbl_weather = lv_label_create(standby_root);
        lv_obj_align(lbl_weather, LV_ALIGN_RIGHT_MID, -15, 0);
        lv_obj_set_style_text_color(lbl_weather, lv_color_make(140, 150, 175), 0);
    }

    lv_label_set_text(lbl_clock, time_str);

    // Распаковка метео-данных
    JsonDocument doc;
    DeserializationError error = deserializeJson(doc, json_weather_reply);
    if (!error) {
        float current_temp = doc["current_weather"]["temperature"];
        int relative_humidity = doc["hourly"]["relative_humidity_2m"][0];
        float apparent_temp = doc["hourly"]["apparent_temperature"][0];

        char weather_buff[128];
        snprintf(weather_buff, sizeof(weather_buff), "+%.0f°C\nОщущается: %.0f°\nВлажность: %d%%", 
                 current_temp, apparent_temp, relative_humidity);
        lv_label_set_text(lbl_weather, weather_buff);
    }
    
    if(lv_screen_active() != standby_root) {
        lv_screen_load(standby_root);
    }
}

