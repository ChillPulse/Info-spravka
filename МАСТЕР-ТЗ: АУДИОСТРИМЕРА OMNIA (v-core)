#include "esp_vfs_fat.h"#include "driver/sdspi_host.h"#include "driver/spi_common.h"#include "sdmmc_cmd.h"#include "config_pins.h"#include "esp_log.h"#include "tinyusb.h"#include "tusb_msc_storage.h"
static const char* TAG = "OMNIA_STORAGE";static sdmmc_card_t* s_card = nullptr;
bool init_sd_card_spi() {
    ESP_LOGI(TAG, "Инициализация SD-карты на выделенной шине SPI3...");
    
    spi_bus_config_t bus_cfg = {
        .mosi_io_num = PIN_SD_MOSI,
        .miso_io_num = PIN_SD_MISO,
        .sclk_io_num = PIN_SD_SCK,
        .quadwp_io_num = -1,
        .quadhd_io_num = -1,
        .max_transfer_sz = 16384,
        .flags = SPICOMMON_BUSFLAG_MASTER
    };
    
    if (spi_bus_initialize(SPI3_HOST, &bus_cfg, SPI_DMA_CH_AUTO) != ESP_OK) {
        ESP_LOGE(TAG, "Не удалось инициализировать шину SPI3!");
        return false;
    }

    sdc_slot_config_t slot_config = SDSPI_SLOT_CONFIG_DEFAULT();
    slot_config.gpio_cs = (gpio_num_t)PIN_SD_CS;
    slot_config.host_id = SPI3_HOST;

    esp_vfs_fat_sdmmc_mount_config_t mount_config = {
        .format_if_mount_failed = false,
        .max_files = 5,
        .allocation_unit_size = 16 * 1024
    };

    sdmmc_host_t host = SDSPI_HOST_DEFAULT();
    host.slot = SPI3_HOST;
    host.max_freq_khz = 20000; // Стабильные 20 МГц для SPI режима SD

    esp_err_t err = esp_vfs_fat_sdcard_mount("/sd", &host, &slot_config, &mount_config, &s_card);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "Ошибка монтирования VFS раздела /sd. Код: %s", esp_err_to_name(err));
        return false;
    }

    ESP_LOGI(TAG, "SD-карта успешно смонтирована по пути /sd");
    return true;
}
