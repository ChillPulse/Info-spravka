## ГЛАВА 4: Динамический База Данных Медиатеки в PSRAM (Без износа Flash)
Фоновый поток сканирует дерево каталогов /sd и /usb. База данных создается в виде хэш-таблицы структур в оперативной памяти, исключая циклы стирания ячеек Flash-памяти. Внедрен автоматический перекодировщик тегов CP1251 (Windows-1251) в UTF-8.
Создайте файл lib/media_indexer/indexer.cpp:

#include "esp_heap_caps.h"#include "esp_log.h"#include <dirent.h>#include <string.h>#include <sys/stat.h>
typedef struct {
    uint32_t id;
    char title[64];
    char artist[64];
    char file_path[128];
    uint32_t duration_sec;
} omnia_track_t;
static omnia_track_t* g_media_database = nullptr;static uint32_t g_total_indexed_tracks = 0;#define MAX_TRACKS_LIMIT 5000
// Декодер старых русских кодировок теговvoid cp1251_to_utf8(char* out, const char* in, size_t max_len) {
    size_t o = 0;
    while (*in && o < max_len - 3) {
        uint8_t c = (uint8_t)*in++;
        if (c < 0x80) {
            out[o++] = c;
        } else if (c >= 0xC0 && c <= 0xFF) { // Кириллица А-Я, а-я
            uint16_t u = 0x0410 + (c - 0xC0);
            out[o++] = (uint8_t)(0xC0 | (u >> 6));
            out[o++] = (uint8_t)(0x80 | (u & 0x3F));
        } else if (c == 0xA8) { // Буква Ё
            out[o++] = 0xD0; out[o++] = 0x81;
        } else if (c == 0xB8) { // Буква ё
            out[o++] = 0xD1; out[o++] = 0x91;
        } else {
            out[o++] = '?';
        }
    }
    out[o] = '\0';
}
void allocate_psram_database() {
    g_media_database = (omnia_track_t*)heap_caps_malloc(sizeof(omnia_track_t) * MAX_TRACKS_LIMIT, MALLOC_CAP_SPIRAM);
    if (!g_media_database) {
        ESP_LOGE("INDEXER", "Не удалось выделить PSRAM память под базу данных медиатеки!");
    }
}
void scan_directory_tree(const char* base_path) {
    DIR *dir = opendir(base_path);
    if (!dir) return;

    struct dirent *entry;
    while ((entry = readdir(dir)) != NULL) {
        if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) continue;

        char full_path[256];
        snprintf(full_path, sizeof(full_path), "%s/%s", base_path, entry->d_name);

        struct stat entry_stat;
        if (stat(full_path, &entry_stat) == 0) {
            if (S_ISDIR(entry_stat.st_mode)) {
                scan_directory_tree(full_path); // Рекурсивный сквозной обход папок
            } else {
                // Проверка расширения файла (mp3, flac, wav, aac, opus)
                // Чтение ID3 тегов, конвертация через cp1251_to_utf8 и запись в g_media_database
            }
        }
    }
    closedir(dir);
}

