## ГЛАВА 5: Audio Engine и Bit-Perfect I2S DMA вывод на Core 0
Главный диспетчер задач vTaskAudioEngine на Core 0 забирает декодированные фреймы из ADF-конвейера, отправляет их в DSP-процессор (Том 3) и транслирует в шину I2S0 DMA. Применяется Gapless-сшивка (декодирование следующего трека начинается в буфер за 5 секунд до окончания текущего).
Создайте файл src/core0_audio.cpp:

#include "freertos/FreeRTOS.h"#include "freertos/task.h"#include "audio_buffer.h"#include "config_pins.h"#include "driver/i2s_std.h"#include "esp_log.h"
extern OmniaAudioBuffer audio_buffer;static i2s_chan_handle_t tx_channel = NULL;
void init_i2s_dma_bit_perfect() {
    i2s_chan_config_t chan_cfg = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);
    chan_cfg.auto_clear = true; // Защита от хрипа: автоочистка DMA при опустошении буфера
    i2s_new_channel(&chan_cfg, &tx_channel, NULL);

    i2s_std_config_t std_cfg = {
        .clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(44100), // Базовая частота, меняется динамически
        .slot_cfg = I2S_STD_MSB_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_32BIT, I2S_SLOT_MODE_STEREO),
        .gpio_cfg = {
            .mclk = I2S_GPIO_UNUSED,
            .bclk = (gpio_num_t)PIN_I2S_BCK,
            .ws = (gpio_num_t)PIN_I2S_LRCK,
            .dout = (gpio_num_t)PIN_I2S_DIN,
            .din = I2S_GPIO_UNUSED,
            .invert_flags = { .mclk_inv = false, .bclk_inv = false, .ws_inv = false }
        }
    };
    i2s_channel_init_std_match(tx_channel, &std_cfg);
    i2s_channel_enable(tx_channel);
    
    gpio_set_level((gpio_num_t)PIN_I2S_XSMT, 1); // Снятие аппаратного затухания ЦАП PCM5102A
}
void vTaskAudioEngine(void *pvParameters) {
    ESP_LOGI("CORE0", "Запуск Audio Engine на ядре %d", xPortGetCoreID());
    init_i2s_dma_bit_perfect();
    
    // Выделение буфера вывода во внутренней DMA-доступной SRAM памяти
    uint8_t* dma_output_buffer = (uint8_t*)heap_caps_malloc(2048, MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA);
    size_t bytes_written = 0;

    while (1) {
        // Чтение PCM из конвейера после кодеков (FLAC/AAC/MP3/Opus) и DSP цепочки
        size_t read_bytes = audio_buffer.read(dma_output_buffer, 2048);
        if (read_bytes > 0) {
            i2s_channel_write(tx_channel, dma_output_buffer, read_bytes, &bytes_written, portMAX_DELAY);
        } else {
            vTaskDelay(pdMS_TO_TICKS(4)); // Экономия MIPS при паузе
        }
    }
}

