## ГЛАВА 5: Сетевое PWA Управление смартфона и скрипт калибровки Room Correction
Бэкенд сервера на Core 0 обменивается данными с PWA приложением телефона по асинхронному WebSocket-протоколу. Внедрен революционный алгоритм калибровки: телефон генерирует розовый шум, микрофон смартфона слушает комнату, JS скрипт браузера вычисляет резонансные пики стоячих волн помещения и шлет готовые биквадраты в ESP32-S3.
Создайте сжатый файл фронтенда data/index.html.gz и бэкенд lib/ui_engine/web_server.cpp:

#include "ESPAsyncWebServer.h"#include "ArduinoJson.h"#include "dsp_core.h"#include "esp_log.h"
extern AsyncWebServer server;AsyncWebSocket ws("/ws");extern OmniaDSPCore dsp_processor;
void on_websocket_event(AsyncWebSocket *server, AsyncWebSocketClient *client, AwsEventType type,
                      void *arg, uint8_t *data, size_t len) {
    if (type == WS_EVT_DATA) {
        JsonDocument doc;
        DeserializationError error = deserializeJson(doc, (char*)data);
        if (error) return;

        const char* cmd = doc["cmd"];
        
        // ПЕРЕХВАТ ПАКЕТА ИНТЕЛЛЕКТУАЛЬНОЙ КАЛИБРОВКИ С ТЕЛЕФОНА (ROOM CORRECTION)
        if (strcmp(cmd, "CALIBRATE_ROOM") == 0) {
            uint8_t band = doc["band"];
            float center_freq = doc["freq"];
            float q_factor = doc["q"];
            float room_gain = doc["gain"]; // Вырезанный микрофоном телефона гул комнаты

            // Жесткая фиксация хирургического Слоя 1 коррекции в фоне
            dsp_processor.set_room_correction(band, center_freq, q_factor, room_gain);
            ESP_LOGI("WEB_DSP", "Профиль Room Correction зафиксирован для полосы %d: %.1f Гц", band, center_freq);
        }
        
        if (strcmp(cmd, "SET_VOLUME") == 0) {
            uint8_t vol = doc["value"];
            // Изменение системной громкости
        }
    }
}
void init_vcore_web_control() {
    ws.onEvent(on_websocket_event);
    server.addHandler(&ws);
    
    // Передача сжатого PWA интерфейса из LittleFS во Flash
    server.on("/", HTTP_GET, [](AsyncWebServerRequest *request){
        AsyncWebServerResponse *response = request->beginResponse(LittleFS, "/index.html.gz", "text/html");
        response->addHeader("Content-Encoding", "gzip");
        request->send(response);
    });

    server.begin();
}

