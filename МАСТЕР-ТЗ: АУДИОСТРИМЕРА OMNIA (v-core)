## ГЛАВА 6: Драйвер 12-битного RGB-кольца на базе модуля RMT и преобразователя уровней SN74AHCT125N
Для интеграции светодиодного кольца в архитектуру Omnia (v-core) применяется важное аппаратное решение: согласование логических уровней [💡].
Выходные пины ESP32-S3 выдают сигналы амплитудой 3.3В, в то время как адресные светодиоды WS2812B требуют для стабильной работы и корректного распознавания таймингов строго 5В логику. Использование микросхемы SN74AHCT125N (Quad Bus Buffer с TTL-совместимыми входами) в роли шинного формирователя полностью решает эту проблему, обеспечивая крутые, неискаженные фронты импульсов и защищая светодиоды от сбоев в цветопередаче.
Поскольку ваше кольцо имеет 12 светодиодов (12-пиксельная геометрия), а на плате YD-ESP32-S3 первый светодиод уже распаян на текстолите на GPIO 48, мы конфигурируем конвейер на последовательную адресацию: 1 встроенный + 12 внешних пикселей = 13 LED-элементов в одной сигнальной цепи.
Агент разворачивает потокобезопасный модуль анимации на Core 1 в файлах lib/ui_engine/anima_light.h и lib/ui_engine/anima_light.cpp через официальный драйвер ESP-IDF RMT (Remote Control Peripheral):
## 1. Файл lib/ui_engine/anima_light.h

#pragma once#include <stdint.h>#include <stddef.h>
#define TOTAL_LED_COUNT 13 // 1 встроенный на плате YD + 12 внешних в кольце
typedef enum {
    LIGHT_MODE_STANDBY,
    LIGHT_MODE_PLAYING,
    LIGHT_MODE_PAUSED,
    LIGHT_MODE_VOLUME
} ring_light_mode_t;
class OmniaAnimaLight {private:
    uint8_t m_led_buffer[TOTAL_LED_COUNT * 3]; // GRB структура данных
    uint8_t m_global_brightness_limit;         // Динамический лимит от датчика Lux
    ring_light_mode_t m_current_mode;
    uint32_t m_step_counter;
public:
    OmniaAnimaLight();
    void init();
    void set_mode(ring_light_mode_t mode);
    void update_brightness_from_lux(uint32_t lux);
    void process_animation_tick(float* fft_bass_data, uint8_t current_volume);
    void commit_buffer_to_rmt();
};

## 2. Файл lib/ui_engine/anima_light.cpp

#include "anima_light.h"#include "config_pins.h"#include "driver/rmt_tx.h"#include "led_strip_encoder.h" // Официальный IDF плагин кодирования таймингов WS2812#include "esp_log.h"#include <math.h>#include <string.h>
static const char* TAG = "OMNIA_LIGHT";static rmt_channel_handle_t led_chan = NULL;static rmt_encoder_handle_t led_encoder = NULL;
OmniaAnimaLight::OmniaAnimaLight() : m_global_brightness_limit(30), m_current_mode(LIGHT_MODE_STANDBY), m_step_counter(0) {}
void OmniaAnimaLight::init() {
    ESP_LOGI(TAG, "Инициализация аппаратного RMT для RGB-кольца через SN74AHCT125N...");

    rmt_tx_channel_config_t tx_chan_config = {
        .gpio_num = (gpio_num_t)PIN_RGB_RING, // GPIO 48 -> Вход 1A (Pin 2) чипа SN74AHCT125N
        .clk_src = RMT_CLK_SRC_DEFAULT,
        .mem_block_symbols = 64,
        .resolution_hz = 10000000, // 10 МГц разрешение таймингов (100 нс на такт)
        .trans_queue_depth = 4,
        .flags = { .with_dma = false }
    };
    rmt_new_tx_channel(&tx_chan_config, &led_chan);

    led_strip_encoder_config_t encoder_config = { .resolution = 10000000 };
    rmt_new_led_strip_encoder(&encoder_config, &led_encoder);
    rmt_enable(led_chan);

    // Принудительно притягиваем управляющий вход /1OE (Pin 1) чипа SN74AHCT125N к GND на плате
    // для постоянной активации буфера. Выход 1Y (Pin 3) чипа выдает честные 5В в DI кольца.
    memset(m_led_buffer, 0, sizeof(m_led_buffer));
    commit_buffer_to_rmt();
}
void OmniaAnimaLight::update_brightness_from_lux(uint32_t lux) {
    // Логарифмический лимитер: в темноте приглушаем до 5%, чтобы не слепить, днем — до 40%
    if (lux < 5)        m_global_brightness_limit = 10; 
    else if (lux < 200) m_global_brightness_limit = 45;
    else                m_global_brightness_limit = 100;
}
void OmniaAnimaLight::set_mode(ring_light_mode_t mode) {
    m_current_mode = mode;
}
void OmniaAnimaLight::process_animation_tick(float* fft_bass_data, uint8_t current_volume) {
    m_step_counter++;
    float brightness_scale = (float)m_global_brightness_limit / 255.0f;

    // Светодиод №0 (Встроенный на плате YD-ESP32-S3) работает как индикатор статуса
    if (m_current_mode == LIGHT_MODE_STANDBY) {
        m_led_buffer[0] = 5; m_led_buffer[1] = 0; m_led_buffer[2] = 0; // Тусклый красный
    } else {
        m_led_buffer[0] = 0; m_led_buffer[1] = 5; m_led_buffer[2] = 0; // Тусклый зеленый
    }

    // Обработка 12 внешних пикселей кольца (Индексы 1 - 12)
    switch (m_current_mode) {
        
        // 1. РЕЖИМ СТЕНДБАЙ: Аритмичный «Сердечный пульс» (Heartbeat Breathing)
        case LIGHT_MODE_STANDBY: {
            float sin_wave = sinf((float)m_step_counter * 0.04f);
            // Псевдоаритмия: создание двойного пика сокращения
            if (sin_wave < 0) sin_wave = fabsf(sin_wave) * 0.2f; 
            
            uint8_t indigo_blue = (uint8_t)(sin_wave * 60.0f * brightness_scale);
            for (int i = 1; i <= 12; i++) {
                m_led_buffer[i * 3 + 0] = 0;           // Green
                m_led_buffer[i * 3 + 1] = 0;           // Red
                m_led_buffer[i * 3 + 2] = indigo_blue; // Blue (Индиго синий)
            }
            break;
        }

        // 2. РЕЖИМ PLAYING: Градиентная «Аврора» с физической пульсацией от НЧ (FFT Bass)
        case LIGHT_MODE_PLAYING: {
            float bass_energy = (fft_bass_data[0] + fft_bass_data[1] + fft_bass_data[2]) / 3.0f;
            float bass_mod = 1.0f + (bass_energy * 0.5f); // Коэффициент модуляции яркости басом

            for (int i = 1; i <= 12; i++) {
                uint8_t hue = (m_step_counter + (i * 256 / 12)) % 255;
                // Асинхронное перетекание цветов темы (пример неонового цианово-пурпурного градиента)
                m_led_buffer[i * 3 + 0] = (uint8_t)((uint8_t)(hue) * brightness_scale * bass_mod);        // G
                m_led_buffer[i * 3 + 1] = (uint8_t)((uint8_t)(255 - hue) * brightness_scale * bass_mod);  // R
                m_led_buffer[i * 3 + 2] = (uint8_t)(150 * brightness_scale * bass_mod);                  // B
            }
            break;
        }

        // 3. РЕЖИМ VOLUME: 12-сегментный круговой индикатор уровня громкости
        case LIGHT_MODE_VOLUME: {
            uint8_t active_leds = (current_volume * 12) / 100;
            for (int i = 1; i <= 12; i++) {
                if (i <= active_leds) {
                    // Плавный цветовой переход шкалы: от зеленого к желтому и красному
                    m_led_buffer[i * 3 + 0] = (i < 8) ? (uint8_t)(100 * brightness_scale) : 0; // G
                    m_led_buffer[i * 3 + 1] = (i >= 5) ? (uint8_t)(150 * brightness_scale) : 0; // R
                    m_led_buffer[i * 3 + 2] = 0;
                } else {
                    m_led_buffer[i * 3 + 0] = 0; m_led_buffer[i * 3 + 1] = 0; m_led_buffer[i * 3 + 2] = 0;
                }
            }
            break;
        }

        case LIGHT_MODE_PAUSED: {
            for (int i = 1; i <= 12; i++) {
                m_led_buffer[i * 3 + 0] = (uint8_t)(30 * brightness_scale); // Мягкий статичный янтарный
                m_led_buffer[i * 3 + 1] = (uint8_t)(50 * brightness_scale);
                m_led_buffer[i * 3 + 2] = 0;
            }
            break;
        }
    }
    commit_buffer_to_rmt();
}
void OmniaAnimaLight::commit_buffer_to_rmt() {
    rmt_transmit_config_t tx_config = { .loop_count = 0, .flags = { .eot_cb_as_isr = false } };
    // Скоростной выстрел пакета таймингов в SN74AHCT125N без блокировки ядер процессора
    rmt_transmit(led_chan, led_encoder, m_led_buffer, sizeof(m_led_buffer), &tx_config);
}

