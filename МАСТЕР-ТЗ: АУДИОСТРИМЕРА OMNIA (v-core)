## ГЛАВА 1: Интеллектуальный ИК-модуль самообучения (Mod_IR_Learn) на базе RAW-таймингов
Для обеспечения стопроцентной совместимости с любыми пультами ДУ в мире (NEC, Sony, Philips, Samsung и кастомные протоколы кондиционеров), Omnia (v-core) использует низкоуровневый аппаратный захват длительности импульсов (RAW Timings) с помощью периферийного модуля RMT (Remote Control Peripheral).
Обработкой, фильтрацией и хэшированием ИК-пакетов занимается Core 1, благодаря чему ядро декодирования аудио (Core 0) полностью изолировано от прерываний ИК-приемника.
Агент реализует класс OmniaIRLearn в файлах lib/ui_engine/ir_learn.h и lib/ui_engine/ir_learn.cpp:
## 1. Файл lib/ui_engine/ir_learn.h

#pragma once#include <stdint.h>#include <stddef.h>#include "driver/rmt_rx.h"
#define IR_RAW_BUFFER_SIZE 128#define IR_MAX_COMMANDS 12
typedef enum {
    IR_CMD_POWER = 0,
    IR_CMD_MUTE,
    IR_CMD_SOURCE,
    IR_CMD_FAVORITE,
    IR_CMD_PLAY,
    IR_CMD_VOL_UP,
    IR_CMD_VOL_DOWN,
    IR_CMD_TRACK_NEXT,
    IR_CMD_TRACK_PREV
} ir_action_t;
typedef struct {
    ir_action_t action;
    uint32_t hash;       // Облегченный хэш RAW-массива для мгновенного сравнения
    uint16_t length;
} ir_template_t;
class OmniaIRLearn {private:
    ir_template_t m_saved_templates[IR_MAX_COMMANDS];
    uint8_t m_registered_cmds_count;
    bool m_is_learning_mode;
    ir_action_t m_target_learning_action;

    uint32_t calculate_raw_hash(const rmt_symbol_word_t* rmt_symbols, size_t len);
public:
    OmniaIRLearn();
    void init();
    void start_learning(ir_action_t action);
    void save_to_nvs();
    void load_from_nvs();
    void process_rx_symbols(const rmt_symbol_word_t* symbols, size_t len);
};

## 2. Файл lib/ui_engine/ir_learn.cpp

#include "ir_learn.h"#include "config_pins.h"#include "nvs_flash.h"#include "nvs.h"#include "esp_log.h"
static const char* TAG = "OMNIA_IR";static rmt_channel_handle_t rx_chan = NULL;
OmniaIRLearn::OmniaIRLearn() : m_registered_cmds_count(0), m_is_learning_mode(false) {}
uint32_t OmniaIRLearn::calculate_raw_hash(const rmt_symbol_word_t* rmt_symbols, size_t len) {
    // Алгоритм хэширования FNV-1a для таймингов с допуском джиттера (+/- 15%)
    uint32_t hash = 2166136261U;
    for (size_t i = 0; i < len; i++) {
        // Округляем длительности импульсов до ближайших 100 мкс для нивелирования помех
        uint16_t duration_high = (rmt_symbols[i].num1 / 100) * 100;
        uint16_t duration_low  = (rmt_symbols[i].num2 / 100) * 100;
        
        hash ^= duration_high; hash *= 16777619_u32;
        hash ^= duration_low;  hash *= 16777619_u32;
    }
    return hash;
}
void OmniaIRLearn::init() {
    ESP_LOGI(TAG, "Инициализация аппаратного RMT RX на GPIO %d...", PIN_ENCODER_SW);
    
    rmt_rx_channel_config_t rx_config = {
        .gpio_num = (gpio_num_t)PIN_ENCODER_SW, // ИК-приемник TSOP38238
        .clk_src = RMT_CLK_SRC_DEFAULT,
        .mem_block_symbols = 64,
        .resolution_hz = 1000000, // 1 МГц (1 мкс на такт)
        .flags = { .with_dma = false }
    };
    rmt_new_rx_channel(&rx_config, &rx_chan);

    rmt_rx_event_callbacks_t cbs = {
        // Регистрация прерывания окончания приема пакета
    };
    rmt_enable(rx_chan);
    
    // Аппаратный старт бесконечного мониторинга эфира
    rmt_receive_config_t rx_receive_config = { .signal_range_min_ns = 20000, .signal_range_max_ns = 100000000 };
    rmt_receive(rx_chan, NULL, 0, &rx_receive_config);
    
    load_from_nvs();
}
void OmniaIRLearn::start_learning(ir_action_t action) {
    m_target_learning_action = action;
    m_is_learning_mode = true;
    ESP_LOGI(TAG, "Мастер ИК-обучения активирован для Системной Команды ID: %d", action);
}
void OmniaIRLearn::process_rx_symbols(const rmt_symbol_word_t* symbols, size_t len) {
    uint32_t packet_hash = calculate_raw_hash(symbols, len);

    if (m_is_learning_mode) {
        // Режим сохранения новой команды
        ir_template_t* t = &m_saved_templates[m_target_learning_action];
        t->action = m_target_learning_action;
        t->hash = packet_hash;
        t->length = len;
        
        m_is_learning_mode = false;
        save_to_nvs();
        ESP_LOGI(TAG, "Команда ID: %d успешно заучена. Хэш: 0x%08X", t->action, t->hash);
        return;
    }

    // Стандартный рабочий режим: поиск хэша в базе
    for (uint8_t i = 0; i < m_registered_cmds_count; i++) {
        if (m_saved_templates[i].hash == packet_hash) {
            // Элегантный перехват команды! Отправка системного эвента в очередь FreeRTOS плеера
            ESP_LOGI(TAG, "ИК-Команда Распознана! Вызов Action ID: %d", m_saved_templates[i].action);
            return;
        }
    }
}
void OmniaIRLearn::save_to_nvs() {
    nvs_handle_t nvs_ctx;
    if (nvs_open("omnia_ir", NVS_READWRITE, &nvs_ctx) == ESP_OK) {
        nvs_set_blob(nvs_ctx, "templates", m_saved_templates, sizeof(m_saved_templates));
        nvs_commit(nvs_ctx);
        nvs_close(nvs_ctx);
    }
}
void OmniaIRLearn::load_from_nvs() {
    nvs_handle_t nvs_ctx;
    if (nvs_open("omnia_ir", NVS_READONLY, &nvs_ctx) == ESP_OK) {
        size_t required_size = sizeof(m_saved_templates);
        if (nvs_get_blob(nvs_ctx, "templates", m_saved_templates, &required_size) == ESP_OK) {
            m_registered_cmds_count = IR_MAX_COMMANDS;
            ESP_LOGI(TAG, "ИК-Шаблоны успешно загружены из NVS Flash.");
        }
        nvs_close(nvs_ctx);
    }
}

