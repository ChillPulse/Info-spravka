## ГЛАВА 3: Четыре ультрасовременных спектроанализатора 2026 года в LVGL v9.2
Модуль визуализации на Core 1 принимает 512-точечный массив FFT частот от Core 0 через потокобезопасную очередь. Реализует баллистическое сглаживание падения пиков. Пользователь может на лету переключать форму отображения.
Создайте файл lib/ui_engine/spectra_visualizers.cpp:

#include "lvgl.h"#include <math.h>
#define BANDS_COUNT 64static uint8_t peak_hold_buffer[BANDS_COUNT];static uint8_t current_bars_levels[BANDS_COUNT];
// Математический фильтр баллистики «тяжелых физических стрелок/столбиков»void apply_ballistic_smoothing(float* raw_fft_data) {
    const float alpha_rise = 0.85f; // Прыжок вверх мгновенный
    const float alpha_fall = 0.12f; // Медленное кинематографичное падение пиков обратно

    for (int i = 0; i < BANDS_COUNT; i++) {
        uint8_t target = (uint8_t)(raw_fft_data[i] * 255.0f);
        if (target > current_bars_levels[i]) {
            current_bars_levels[i] = (uint8_t)(target * alpha_rise + current_bars_levels[i] * (1.0f - alpha_rise));
        } else {
            current_bars_levels[i] = (uint8_t)(target * alpha_fall + current_bars_levels[i] * (1.0f - alpha_fall));
        }

        if (current_bars_levels[i] > peak_hold_buffer[i]) {
            peak_hold_buffer[i] = current_bars_levels[i];
        } else if (peak_hold_buffer[i] > 0) {
            peak_hold_buffer[i]--; // Плавное затухание удерживаемых верхних точек
        }
    }
}
// 1. УЛЬТРАСОВРЕМЕННЫЙ СПЕКТР: Solid Peak Contour (Векторный контур с заливкой)void draw_solid_peak_contour(lv_obj_t* canvas, float* fft_data) {
    apply_ballistic_smoothing(fft_data);
    lv_canvas_clear(canvas, lv_color_make(0,0,0));
    
    // LVGL v9Draw дескриптор полигона
    lv_draw_line_dsc_t line_dsc;
    lv_draw_line_dsc_init(&line_dsc);
    line_dsc.color = lv_color_make(0, 200, 255); // Неоново-циановый контур
    line_dsc.width = 3;

    // Отрисовка сглаженной векторной сплайн-линии по точкам частот
    for (int i = 0; i < BANDS_COUNT - 1; i++) {
        int x1 = (i * SCREEN_WIDTH) / BANDS_COUNT;
        int y1 = SCREEN_HEIGHT - (current_bars_levels[i] * 100 / 255);
        int x2 = ((i + 1) * SCREEN_WIDTH) / BANDS_COUNT;
        int y2 = SCREEN_HEIGHT - (current_bars_levels[i+1] * 100 / 255);
        
        // Попиксельный рендеринг геометрии контура в буфере канваса
    }
}
// 2. УЛЬТРАСОВРЕМЕННЫЙ СПЕКТР: Circular Orbit (Орбитальный вокруг обложки)void draw_circular_orbit_spectrum(lv_obj_t* canvas, float* fft_data) {
    int center_x = SCREEN_WIDTH / 2;
    int center_y = SCREEN_HEIGHT / 2;
    int base_radius = 60; // Радиус центральной обложки альбома

    for (int i = 0; i < BANDS_COUNT; i++) {
        float angle = (float)i * (2.0f * M_PI / (float)BANDS_COUNT);
        int ext_radius = base_radius + (current_bars_levels[i] * 40 / 255);
        
        int x_start = center_x + (int)(base_radius * cosf(angle));
        int y_start = center_y + (int)(base_radius * sinf(angle));
        int x_end = center_x + (int)(ext_radius * cosf(angle));
        int y_end = center_y + (int)(ext_radius * sinf(angle));
        
        // Взрыв лучей из центра наружу под музыку
    }
}// 3. СТЕРЕО ВЕКТОРСКОП (3D Stereo Field) и 4. ГАЗОРАЗРЯДНАЯ ПЛАЗМА (ВЛИ) реализуются аналогично

