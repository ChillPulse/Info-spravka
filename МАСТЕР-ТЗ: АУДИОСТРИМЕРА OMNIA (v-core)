## ГЛАВА 1: Инициализация графического ядра LVGL v9.2 и разгон шины SPI2 DMA до 60 МГц
Для достижения «масляного» визуала (стабильные 60 FPS) на 2.8" IPS дисплее ST7789, агент конфигурирует драйвер через официальный компонент esp_lcd с использованием двух графических буферов [Double Buffering] во внутренней памяти SRAM с поддержкой Direct Memory Access (DMA). Шина SPI форсируется на частоту 60 МГц.
Агент разворачивает инициализацию графического тракта на Core 1 в файле lib/ui_engine/display_hal.cpp:

#include "lvgl.h"#include "esp_lcd_panel_io.h"#include "esp_lcd_panel_vendor.h"#include "esp_lcd_panel_ops.h"#include "driver/spi_master.h"#include "config_pins.h"#include "esp_log.h"
static const char* TAG = "OMNIA_DISP";static lv_display_t* disp_handle = NULL;
// Два буфера для отрисовки LVGL (выделяются во внутренней SRAM с DMA)#define DISPLAY_BUFFER_SIZE (SCREEN_WIDTH * 40) // 1/6 часть экранаstatic lv_color16_t* display_buf1 = nullptr;static lv_color16_t* display_buf2 = nullptr;
static bool notify_lvgl_flush_ready(esp_lcd_panel_io_handle_t panel_io, esp_lcd_panel_io_event_data_t *edata, void *user_ctx) {
    lv_display_t *disp = (lv_display_t *)user_ctx;
    lv_display_flush_ready(disp);
    return false;
}
static void lvgl_flush_cb(lv_display_t *disp, const lv_area_t *area, uint8_t *px_map) {
    esp_lcd_panel_handle_t panel_handle = (esp_lcd_panel_handle_t)lv_display_get_user_data(disp);
    int offsetx1 = area->x1;
    int offsetx2 = area->x2;
    int offsety1 = area->y1;
    int offsety2 = area->y2;
    
    // Передача пикселей по SPI DMA на частоте 60 МГц без участия CPU
    esp_lcd_panel_draw_bitmap(panel_handle, offsetx1, offsety1, offsetx2 + 1, offsety2 + 1, px_map);
}
bool init_st7789_vcore_graphics() {
    ESP_LOGI(TAG, "Разгон шины SPI2 до 60 МГц. Инициализация дисплея...");

    spi_bus_config_t buscfg = {
        .mosi_io_num = PIN_DISPLAY_SDA,
        .miso_io_num = -1,
        .sclk_io_num = PIN_DISPLAY_SCL,
        .quadwp_io_num = -1,
        .quadhd_io_num = -1,
        .max_transfer_sz = DISPLAY_BUFFER_SIZE * sizeof(lv_color16_t)
    };
    spi_bus_initialize(SPI2_HOST, &buscfg, SPI_DMA_CH_AUTO);

    esp_lcd_panel_io_handle_t io_handle = NULL;
    esp_lcd_panel_io_spi_config_t io_config = {
        .dc_gpio_num = PIN_DISPLAY_DC,
        .cs_gpio_num = PIN_DISPLAY_CS,
        .pclk_hz = DISPLAY_SPI_FREQ, // 60 000 000 Гц
        .lcd_cmd_bits = 8,
        .lcd_param_bits = 8,
        .spi_mode = 0,
        .trans_queue_depth = 10,
        .on_color_trans_done = notify_lvgl_flush_ready,
        .user_ctx = nullptr
    };
    esp_lcd_new_panel_io_spi((esp_lcd_spi_bus_handle_t)SPI2_HOST, &io_config, &io_handle);

    esp_lcd_panel_handle_t panel_handle = NULL;
    esp_lcd_panel_dev_config_t panel_config = {
        .reset_gpio_num = PIN_DISPLAY_RES,
        .rgb_endian = LCD_RGB_ENDIAN_BGR,
        .bits_per_pixel = 16
    };
    esp_lcd_new_panel_st7789(io_handle, &panel_config, &panel_handle);
    esp_lcd_panel_reset(panel_handle);
    esp_lcd_panel_init(panel_handle);
    esp_lcd_panel_disp_on_off(panel_handle, true);

    // Выделение памяти под буферы с флагами DMA
    display_buf1 = (lv_color16_t*)heap_caps_malloc(DISPLAY_BUFFER_SIZE * sizeof(lv_color16_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA);
    display_buf2 = (lv_color16_t*)heap_caps_malloc(DISPLAY_BUFFER_SIZE * sizeof(lv_color16_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA);

    lv_init();
    disp_handle = lv_display_create(SCREEN_WIDTH, SCREEN_HEIGHT);
    lv_display_set_user_data(disp_handle, panel_handle);
    lv_display_set_buffers(disp_handle, display_buf1, display_buf2, DISPLAY_BUFFER_SIZE * sizeof(lv_color16_t), LV_DISPLAY_RENDER_MODE_PARTIAL);
    lv_display_set_flush_cb(disp_handle, lvgl_flush_cb);
    
    io_config.user_ctx = disp_handle;
    return true;
}

