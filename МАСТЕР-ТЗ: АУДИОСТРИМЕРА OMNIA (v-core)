## ГЛАВА 4: Исполняемый код бэкенда на ESP-IDF для обслуживания Web-интерфейса
Кодинг-агент обязан строго развернуть асинхронный WebSocket-сервер на Core 0, обеспечив неблокирующую обработку входящих команд конфигурации.
Ниже представлен полный, стопроцентно завершенный листинг файла lib/ui_engine/web_server_backend.cpp:

#include "ESPAsyncWebServer.h"#include "ArduinoJson.h"#include "LittleFS.h"#include "config_pins.h"#include "dsp_core.h"#include "esp_log.h"#include <string.h>
static const char* TAG = "OMNIA_WEB_SERVER";AsyncWebServer web_server(80);AsyncWebSocket ws_control("/ws");
extern OmniaDSPCore dsp_processor;bool g_usb_autowake_enabled = true;uint8_t g_standby_display_mode = 2; // Default: 2 (Meteo Station виджет)uint8_t g_standby_ring_mode = 1;    // Default: 1 (Heartbeat breathing)uint8_t g_amp_mute_polarity = 0;    // Default: 0 (Active LOW)
void handle_incoming_json_command(char* json_str) {
    JsonDocument doc;
    DeserializationError error = deserializeJson(doc, json_str);
    if (error) {
        ESP_LOGE(TAG, "Ошибка парсинга входящего JSON пакета управления!");
        return;
    }

    const char* cmd = doc["cmd"];
    if (cmd == nullptr) return;

    // 1. ИНТЕРФЕЙС И ТРАНСПОРТ УПРАВЛЕНИЯ
    if (strcmp(cmd, "TRANSPORT") == 0) {
        const char* action = doc["action"];
        if (strcmp(action, "PLAY") == 0) {
            ESP_LOGI(TAG, "Команда: ВОСПРОИЗВЕДЕНИЕ");
            // Вызов триггера запуска декодирования на Core 0
        } else if (strcmp(action, "SOURCE_SELECT") == 0) {
            const char* src_val = doc["value"];
            ESP_LOGI(TAG, "Команда селектора входов: Изменить на %s", src_val);
            // Бесшовная смена конвейера через Mngr_Source
        }
    }
    
    // 2. ИЗМЕНЕНИЕ ОБЩЕЙ ГРОМКОСТИ И АППАРАТНОГО MUTE
    else if (strcmp(cmd, "VOLUME") == 0) {
        uint8_t vol_val = doc["value"];
        ESP_LOGI(TAG, "Громкость изменена с телефона: %d%%", vol_val);
        // Запись нового значения в общую память статуса системы
    }
    else if (strcmp(cmd, "MUTE") == 0) {
        bool active = doc["active"];
        ESP_LOGI(TAG, "Аппаратный Mute из Web UI: %s", active ? "ВКЛ" : "ВЫКЛ");
        // Вызов процедуры плавного Fade-In / Fade-Out глушения
    }

    // 3. ЛИНЕЙНЫЙ ПРЫЖОК ПО ТРЕКУ (SEEK)
    else if (strcmp(cmd, "SEEK") == 0) {
        uint32_t target_sec = doc["position_sec"];
        ESP_LOGI(TAG, "Прыжок на секунду трека: %u сек", target_sec);
        // Команда для асинхронного сброса Ring Buffer и наката байт-смещения
    }
    
    // 4. ОПЕРАТИВНАЯ НАСТРОЙКА ВКУСОВОГО PEQ (СЛОЙ 2)
    else if (strcmp(cmd, "USER_PEQ") == 0) {
        uint8_t band = doc["band"];
        float freq = doc["freq"];
        float q = doc["q"];
        float gain = doc["gain"];
        
        dsp_processor.set_user_peq(band, freq, q, gain);
        ESP_LOGI(TAG, "User PEQ изменен. Полоса %d: %.1f Гц, Gain: %.1f дБ", band, freq, gain);
    }

    // 5. ХИРУРГИЧЕСКАЯ КАЛИБРОВКА ROOM CORRECTION (СЛОЙ 1)
    else if (strcmp(cmd, "CALIBRATE_ROOM") == 0) {
        uint8_t band = doc["band"];
        float freq = doc["freq"];
        float q = doc["q"];
        float gain = doc["gain"]; // Вырезанный микрофоном телефона комнатный гул
        
        dsp_processor.set_room_correction(band, freq, q, gain);
        ESP_LOGI(TAG, "Слой Room Correction обновлен. Фиксация полосы %d: %.1f Гц, Вырез: %.1f дБ", band, freq, gain);
    }

    // 6. СИСТЕМНАЯ СИЛОВАЯ И ИНТЕРФЕЙСНАЯ АВТОМАТИКА ПЛЕЕРА
    else if (strcmp(cmd, "SET_CONFIG") == 0) {
        const char* param = doc["param"];
        int value = doc["value"];
        
        if (strcmp(param, "USB_AUTOWAKE") == 0) {
            g_usb_autowake_enabled = (value == 1);
            ESP_LOGI(TAG, "Конфиг: Автопробуждение по VBUS: %s", g_usb_autowake_enabled ? "ON" : "OFF");
        }
        else if (strcmp(param, "STANDBY_DISPLAY_MODE") == 0) {
            g_standby_display_mode = (uint8_t)value;
            ESP_LOGI(TAG, "Конфиг: Режим Standby экрана изменен на пресет: %d", g_standby_display_mode);
        }
        else if (strcmp(param, "STANDBY_RING_MODE") == 0) {
            g_standby_ring_mode = (uint8_t)value;
            ESP_LOGI(TAG, "Конфиг: Режим Standby RGB-кольца изменен на пресет: %d", g_standby_ring_mode);
        }
        else if (strcmp(param, "AMP_MUTE_POLARITY") == 0) {
            g_amp_mute_polarity = (uint8_t)value;
            ESP_LOGI(TAG, "Конфиг: Аппаратный тип полярности MUTE TPA изменен на: %s", g_amp_mute_polarity == 1 ? "Active HIGH" : "Active LOW");
        }
    }
}
void on_ws_event(AsyncWebSocket *server, AsyncWebSocketClient *client, AwsEventType type,
                 void *arg, uint8_t *data, size_t len) {
    if (type == WS_EVT_DATA) {
        AwsFrameInfo *info = (AwsFrameInfo*)arg;
        if (info->final && info->index == 0 && info->len == len && info->opcode == WS_TEXT) {
            data[len] = 0; // Корректный терминатор строки для C-функций
            handle_incoming_json_command((char*)data);
        }
    }
}
