## ГЛАВА 4: Бесшовный асинхронный OTA-Апдейт («Seamless Upgrade»)
Разметка Flash-памяти на 16 МБ (default_16MB.csv) делит пространство приложения на два изолированных зеркальных раздела: ota_0 и ota_1. Модуль обновления выполняется асинхронно на Core 1 через веб-сервер плеера.

#include "esp_ota_ops.h"#include "ESPAsyncWebServer.h"#include "esp_log.h"
extern AsyncWebServer web_server;static const char* TAG = "OMNIA_OTA";static esp_ota_handle_t update_handle = 0 ;static const esp_partition_t* update_partition = NULL;
void init_seamless_ota_upgrade() {
    web_server.on("/api/ota_upgrade", HTTP_POST, [](AsyncWebServerRequest *request) {
        // Вызывается по окончании загрузки бинарника прошивки
        AsyncWebServerResponse *response = request->beginResponse(200, "text/plain", "Upgrade Success. Rebooting...");
        response->addHeader("Connection", "close");
        request->send(response);
        vTaskDelay(pdMS_TO_TICKS(1000));
        esp_restart(); // Безопасная программная перезагрузка чипа в новый раздел прошивки
    }, [](AsyncWebServerRequest *request, String filename, size_t index, uint8_t *data, size_t len, bool final) {
        if (index == 0) {
            // Начало стрима прошивки: находим свободный пассивный раздел на Flash
            update_partition = esp_ota_get_next_update_partition(NULL);
            ESP_LOGI(TAG, "Начало фоновой записи прошивки в раздел: %s", update_partition->label);
            esp_ota_begin(update_partition, OTA_SIZE_UNKNOWN, &update_handle);
        }
        
        // Поблочная асинхронная запись секторов Flash памяти
        esp_ota_write(update_handle, (const void *)data, len);
        
        if (final) {
            // Конец стрима: верификация контрольной суммы пакета и переключение флага загрузки RTC
            esp_ota_end(update_handle);
            esp_ota_set_boot_partition(update_partition);
            ESP_LOGI(TAG, "Фоновое обновление завершено успешно. Контрольная сумма валидна.");
        }
    });
}

