## ГЛАВА 4: База данных медиатеки в PSRAM с трансляцией CP1251 в UTF-8
Фоновый поток с низким приоритетом сканирует дерево FATFS. Для предотвращения деградации ячеек памяти контроллера база данных треков (хэш-таблица структур) разворачивается исключительно в PSRAM. Внедрен автоматический перекодировщик тегов для корректного вывода кириллицы.
Создайте файл lib/media_indexer/indexer.cpp:

#include "esp_heap_caps.h"#include "esp_log.h"#include <string.h>#include <dirent.h>
typedef struct {
    uint32_t id;
    char title[128];
    char artist[128];
    char file_path[256];
    uint32_t duration_sec;
} omnia_track_t;
static omnia_track_t* g_psram_db = nullptr;static uint32_t g_indexed_count = 0;#define DATABASE_MAX_TRACKS 5000
void cp1251_to_utf8_converter(char* out, const char* in, size_t max_out_len) {
    size_t o = 0;
    while (*in && o < max_out_len - 3) {
        uint8_t c = (uint8_t)*in++;
        if (c < 0x80) {
            out[o++] = c;
        } else if (c >= 0xC0 && c <= 0xFF) { // Алфавитный диапазон кириллицы
            uint16_t u = 0x0410 + (c - 0xC0);
            out[o++] = (uint8_t)(0xC0 | (u >> 6));
            out[o++] = (uint8_t)(0x80 | (u & 0x3F));
        } else if (c == 0xA8) { out[o++] = 0xD0; out[o++] = 0x81; } // Ё
        else if (c == 0xB8) { out[o++] = 0xD1; out[o++] = 0x91; }   // ё
        else { out[o++] = '?'; }
    }
    out[o] = '\0';
}
void init_psram_media_database() {
    g_psram_db = (omnia_track_t*)heap_caps_malloc(sizeof(omnia_track_t) * DATABASE_MAX_TRACKS, MALLOC_CAP_SPIRAM);
    if (!g_psram_db) {
        ESP_LOGE("INDEXER", "Ошибка выделения PSRAM под динамическую базу данных медиатеки!");
    }
}

