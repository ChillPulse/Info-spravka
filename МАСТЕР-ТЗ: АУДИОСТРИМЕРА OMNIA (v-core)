## 3. Исполняемый файл инициализации периферии ввода src/hal_inputs.cpp
Реализует аппаратный подсчет шагов энкодера через модуль импульсного счетчика PCNT (с фильтрацией дребезга на уровне кремния) и опрос АЦП-клавиатуры.

#include "config_pins.h"#include "driver/pulse_cnt.h"#include "esp_adc/adc_oneshot.h"#include "esp_log.h"#include <string.h>
static pcnt_unit_handle_t pcnt_unit = NULL;static adc_oneshot_unit_handle_t adc1_handle = NULL;
void init_hardware_controls() {
    // 1. АППАРАТНАЯ НАСТРОЙКА PCNT ДЛЯ ИНКРЕМЕНТАЛЬНОГО ЭНКОДЕРА
    pcnt_unit_config_t unit_config = {
        .low_limit = -100,
        .high_limit = 100,
        .flags = { .accum_count = 1 }
    };
    pcnt_new_unit(&unit_config, &pcnt_unit);

    pcnt_glitch_filter_config_t filter_config = {
        .max_glitch_ns = 20000 // Игнорировать любые импульсы помех длительностью менее 20 мкс
    };
    pcnt_unit_set_glitch_filter(pcnt_unit, &filter_config);

    pcnt_chan_config_t chan_a_config = {
        .edge_gpio_num = PIN_ENCODER_A,
        .level_gpio_num = PIN_ENCODER_B,
        .flags = {}
    };
    pcnt_channel_handle_t pcnt_chan_a = NULL;
    pcnt_new_channel(pcnt_unit, &chan_a_config, &pcnt_chan_a);

    // Логика квадратурного декодера: шаг по фронту, направление по уровню второго пина
    pcnt_channel_set_edge_action(pcnt_chan_a, PCNT_EDGE_ACTION_INCREASE, PCNT_EDGE_ACTION_HOLD);
    pcnt_channel_set_level_action(pcnt_chan_a, PCNT_LEVEL_ACTION_KEEP, PCNT_LEVEL_ACTION_INVERSE);
    
    pcnt_unit_enable(pcnt_unit);
    pcnt_unit_start(pcnt_unit);

    // 2. ЦИФРОВОЙ ВВОД КНОПКИ ЭНКОДЕРА (GPIO 43)
    gpio_reset_pin((gpio_num_t)PIN_ENCODER_SW);
    gpio_set_direction((gpio_num_t)PIN_ENCODER_SW, GPIO_MODE_INPUT);
    gpio_set_pull_mode((gpio_num_t)PIN_ENCODER_SW, GPIO_PULLUP_ONLY);

    // 3. ПРЕЦИЗИОННЫЙ ОПРОС АЦП ДЛЯ 6-КНОПОЧНОЙ МАТРИЦЫ (GPIO 3)
    adc_oneshot_unit_init_config_t init_config1 = {
        .unit_id = ADC_UNIT_1,
        .ulp_mode = ADC_ULP_MODE_DISABLE,
    };
    adc_oneshot_unit_init(&init_config1, &adc1_handle);

    adc_oneshot_chan_config_t config = {
        .atten = ADC_ATTEN_DB_12,      // Замер в диапазоне 0 - 3.1В
        .bitwidth = ADC_BITWIDTH_12,   // 12-битное разрешение (0 - 4095)
    };
    adc_oneshot_config_channel(adc1_handle, ADC_CHANNEL_2, &config);
}
// Потокобезопасное определение нажатой кнопки на основе АЦП-зонconst char* check_adc_keyboard() {
    int adc_raw = 0;
    if (adc_oneshot_read(adc1_handle, ADC_CHANNEL_2, &adc_raw) != ESP_OK) {
        return "NONE";
    }
    
    // Сверка с калибровочной сеткой прецизионного резистивного делителя
    if (adc_raw < 150)   return "KEY_POWER";
    if (adc_raw < 700)   return "KEY_MUTE";
    if (adc_raw < 1300)  return "KEY_SOURCE";
    if (adc_raw < 1900)  return "KEY_FAVORITE";
    if (adc_raw < 2500)  return "KEY_PREV";
    if (adc_raw < 3200)  return "KEY_NEXT";
    if (adc_raw < 3800)  return "KEY_PLAY";
    return "NONE";
}
int32_t get_encoder_delta() {
    int pulse_count = 0;
    pcnt_unit_get_count(pcnt_unit, &pulse_count);
    if (pulse_count != 0) {
        pcnt_unit_clear_count(pcnt_unit); // Сброс счетчика после чтения для дельта-анализа
    }
    return (int32_t)pulse_count;
}

