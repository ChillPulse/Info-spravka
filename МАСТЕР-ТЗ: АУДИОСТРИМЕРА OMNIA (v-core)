## ГЛАВА 5: Архитектура сквозного Audio Pipeline FreeRTOS на Core 0
Главная рабочая задача vTaskAudioEngine на Core 0 управляет аудиоконвейером: считывает данные из OmniaAudioBuffer, отправляет в соответствующий декодер фреймворка ESP-ADF, перенаправляет PCM фрейм в DSP процессор и осуществляет финальный вывод в I2S DMA.
Создайте файл src/core0_audio.cpp:

#include "freertos/FreeRTOS.h"#include "freertos/task.h"#include "audio_buffer.h"#include "config_pins.h"#include "driver/i2s_std.h"#include "esp_log.h"
extern OmniaAudioBuffer audio_buffer;static i2s_chan_handle_t tx_chan = NULL;
void init_i2s_bit_perfect() {
    i2s_chan_config_t chan_cfg = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);
    chan_cfg.auto_clear = true; // Автоочистка DMA при нехватке данных (анти-хрип)
    i2s_new_channel(&chan_cfg, &tx_chan, NULL);

    i2s_std_config_t std_cfg = {
        .clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(44100),
        .slot_cfg = I2S_STD_MSB_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_32BIT, I2S_SLOT_MODE_STEREO),
        .gpio_cfg = {
            .mclk = I2S_GPIO_UNUSED,
            .bclk = (gpio_num_t)PIN_I2S_BCK,
            .ws = (gpio_num_t)PIN_I2S_LRCK,
            .dout = (gpio_num_t)PIN_I2S_DIN,
            .din = I2S_GPIO_UNUSED,
            .invert_flags = { .mclk_inv = false, .bclk_inv = false, .ws_inv = false }
        }
    };
    i2s_channel_init_std_match(tx_chan, &std_cfg);
    i2s_channel_enable(tx_chan);
    
    gpio_set_level((gpio_num_t)PIN_I2S_XSMT, 1); // Снятие аналогового мьюта ЦАП PCM5102A
}
void vTaskAudioEngine(void *pvParameters) {
    ESP_LOGI("CORE0", "Запуск Audio Engine задачи на ядре %d", xPortGetCoreID());
    init_i2s_bit_perfect();
    
    uint8_t* pcm_output_buffer = (uint8_t*)heap_caps_malloc(4096, MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA);
    size_t bytes_written = 0;

    while (1) {
        // 1. Извлечение закодированных фреймов из 4 МБ буфера PSRAM
        // 2. Декодирование (FLAC/AAC/MP3/Opus) силами ESP-ADF
        // 3. Вызов DSP конвейера (Том 3) для float32_t фильтрации
        
        // Пример прямой сквозной передачи PCM данных в I2S DMA
        size_t read_bytes = audio_buffer.read(pcm_output_buffer, 4096);
        if (read_bytes > 0) {
            i2s_channel_write(tx_chan, pcm_output_buffer, read_bytes, &bytes_written, portMAX_DELAY);
        } else {
            vTaskDelay(pdMS_TO_TICKS(5)); // Сон при пустом буфере для разгрузки CPU
        }
    }
}

